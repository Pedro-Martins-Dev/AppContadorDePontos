<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A2828"
    tools:context="com.seu.pacote">

    <TextView
        android:id="@+id/tituloApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/containerDosTimes"
        android:layout_alignParentTop="true"
        android:layout_marginTop="82dp"
        android:layout_marginBottom="108dp"
        android:gravity="center"
        android:text="Grifória x Corvinal"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="40sp" />

    <LinearLayout
        android:id="@+id/containerDosTimes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/reiniciarPartida"
        android:layout_marginBottom="219dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/fundo_arredondado"
            android:backgroundTint="#B60202"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/timeA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="start"
                    android:padding="16dp"
                    android:text="Grifinória"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/removerPontoTimeA"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:background="@drawable/botao_remover_ponto"
                    android:padding="0dp"
                    android:textColor="#FFFFFF"

                    android:text="-1" />
            </RelativeLayout>

            <TextView
                android:id="@+id/placarTimeA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="#FFFFFF"
                android:text="0"
                android:textSize="54sp" />

            <Button
                android:id="@+id/tresPontosA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/botoes_acao"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="+3 PONTOS" />

            <Button
                android:id="@+id/doisPontosA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/botoes_acao"
                android:backgroundTint="#8BC34A"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="+2 PONTOS" />

            <Button
                android:id="@+id/tiroLivreA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/botoes_acao"
                android:backgroundTint="#CDDC39"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Tiro Livre" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:background="@android:color/darker_gray" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/fundo_arredondado"
            android:backgroundTint="#064B83"
            android:orientation="vertical">>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/timeB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="start"
                    android:padding="16dp"
                    android:text="Corvinal"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/removerPontoTimeB"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="8dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="3dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/botao_remover_ponto"
                    android:padding="0dp"
                    android:textColor="#FFFFFF"
                    android:text="-1" />
            </RelativeLayout>

            <TextView
                android:id="@+id/placarTimeB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:padding="4dp"
                android:text="0"
                android:textSize="54sp" />

            <Button
                android:id="@+id/tresPontosB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/botoes_acao"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="+3 PONTOS" />

            <Button
                android:id="@+id/doisPontosB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/botoes_acao"
                android:backgroundTint="#8BC34A"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="+2 PONTOS" />

            <Button
                android:id="@+id/tiroLivreB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/botoes_acao"
                android:backgroundTint="#CDDC39"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Tiro Livre" />
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/reiniciarPartida"
        android:layout_width="812dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="32dp"
        android:layout_marginLeft="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginRight="32dp"
        android:layout_marginBottom="31dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:text="Reiniciar Partida"
        android:backgroundTint="#00BFA5"
        android:background="@drawable/botoes_acao"
        />
</RelativeLayout>